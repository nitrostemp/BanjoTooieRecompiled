{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TOOIE_NATIVE_HOST": "ON",
        "TOOIE_DEPS_ROOT": "${sourceDir}/deps",
        "TOOIE_ROM_PATH": "${sourceDir}/baserom.us.z64"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows developer build (pinned clang-cl)",
      "description": "Run from an x64 Visual Studio 2022 Developer PowerShell after bootstrapping --with-windows-toolchain.",
      "inherits": "native-base",
      "environment": {
        "PATH": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin/clang-cl.exe",
        "CMAKE_MT": "mt.exe",
        "CMAKE_CXX_FLAGS": "-Xclang -fexceptions -Xclang -fcxx-exceptions"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon developer build",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/macos-dev",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_PREFIX_PATH": "/opt/homebrew;/opt/homebrew/opt/openssl@3"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux developer build",
      "inherits": "native-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "targets": ["TooieRecompiled"],
      "jobs": 6
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "targets": ["TooieRecompiled"],
      "jobs": 6
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "targets": ["TooieRecompiled"],
      "jobs": 6
    }
  ],
  "testPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "output": {"outputOnFailure": true}
    }
  ]
}
